# Database Configuration
POSTGRES_USER=itma_user
POSTGRES_PASSWORD=itma_password
POSTGRES_DB=itma_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transport-telemetry
KAFKA_CONSUMER_GROUP=itma-traffic-consumer

# GTFS Feed URL
GTFS_FEED_URL=https://gtfs.transjakarta.co.id/files/file_gtfs.zip

# Airflow Configuration
# Linux: ganti dengan hasil `id -u` agar dbt bisa menulis folder transform/ (target, logs, dbt_packages)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
